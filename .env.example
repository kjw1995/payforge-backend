# .env 로 복사해서 사용한다. docker compose 와 Spring(application.yaml 의 spring.config.import)이 함께 읽는다.
# 비밀번호는 영문·숫자만 쓴다($ 나 \ 는 compose 와 properties 에서 각각 다르게 해석된다).
MYSQL_BIND=100.109.120.75
MYSQL_PORT=3308

# 앱이 접속할 호스트. DB 를 띄운 PC 에서는 127.0.0.1, 다른 PC 에서는 100.109.120.75
DB_HOST=100.109.120.75

MYSQL_DATABASE=payforge
MYSQL_USER=payforge
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
